<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">

            <StackPanel Spacing="10">
                
                <Button Classes="btn btn-outline">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Label Classes="btn-icon" FontFamily="{StaticResource PhosphorFill}" Content="&#xe272;"></Label>
                        <Label>Settings</Label>
                    </StackPanel>
                </Button>

                <Button Classes="btn btn-primary">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Label Classes="btn-icon" FontFamily="{StaticResource PhosphorFill}" Content="&#xe272;"></Label>
                        <Label>Settings</Label>
                    </StackPanel>
                </Button>

            </StackPanel>

        </Border>
    </Design.PreviewWith>

    <Style Selector="Button.btn">
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6 3" />
    </Style>

    <Style Selector="Button.btn.btn-outline">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style Selector="Button.btn.btn-primary Label">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="Button.btn.btn-primary TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>


    <Style Selector="Button.btn.btn-outline:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="Button.btn.btn-primary">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrushDark}" />
    </Style>

    <Style Selector="Button.btn.btn-primary Label">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.btn.btn-primary TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>


    <Style Selector="Button.btn.btn-primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrushDark}" />
    </Style>


    <Style Selector="Button.btn Label.btn-icon">
        <Setter Property="Margin" Value="0 1 0 0"></Setter>
    </Style>
</Styles>