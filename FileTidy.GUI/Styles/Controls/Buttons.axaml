<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">

            <StackPanel Spacing="10">
                
                <Button Classes="btn btn-outline">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Label Classes="btn-icon" FontFamily="{StaticResource PhosphorFill}" Content="&#xe272;"></Label>
                        <Label>Settings</Label>
                    </StackPanel>
                </Button>

                <Button Classes="btn btn-primary">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Label Classes="btn-icon" FontFamily="{StaticResource PhosphorFill}" Content="&#xe272;"></Label>
                        <Label>Settings</Label>
                    </StackPanel>
                </Button>

            </StackPanel>

        </Border>
    </Design.PreviewWith>

    <Style Selector="Button.btn">
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6 3" />
    </Style>
    
    <Style Selector="Button.btn /template/ ContentPresenter">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.btn > StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.btn.btn-outline">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style Selector="Button.btn.btn-primary Label">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="Button.btn.btn-primary TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>


    <Style Selector="Button.btn.btn-outline:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="Button.btn.btn-primary">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrushDark}" />
    </Style>

    <Style Selector="Button.btn.btn-primary Label">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.btn.btn-primary TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>


    <Style Selector="Button.btn.btn-primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrushDark}" />
    </Style>


    <Style Selector="Button.btn Label.btn-icon">
        <Setter Property="Margin" Value="0 1 0 0"></Setter>
    </Style>
    
    <Style Selector="Button:disabled > StackPanel > Label">
        <Setter Property="Foreground" Value="{DynamicResource Gray500}"></Setter>
    </Style>
    <Style Selector="Button:disabled > StackPanel > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Gray500}"></Setter>
    </Style>
    
    <!-- Button Size Variants -->
    <Style Selector="Button.btn.btn-sm">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="4 2" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Height" Value="28" />
    </Style>

    <Style Selector="Button.btn.btn-md">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="6 3" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Height" Value="36" />
    </Style>

    <Style Selector="Button.btn.btn-lg">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="10 5" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Height" Value="44" />
    </Style>
    
    <Style Selector="Button.btn.btn-xl">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Padding" Value="12 6" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="Height" Value="52" />
    </Style>

    <Style Selector="Button.btn.btn-2xl">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="14 8" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Height" Value="60" />
    </Style>

</Styles>