<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="FileTidy.GUI.Views.Onboarding.Steps.WelcomeStepView"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
    <Grid>
        <StackPanel Spacing="16" HorizontalAlignment="Left">
            <TextBlock Text="Hello." FontSize="35" FontWeight="SemiBold"/>
            <TextBlock Text="Thanks for installing FileTidy. The next few steps will ensure the desktop app will work properly on your machine."
                       FontSize="18"
                       Opacity="0.88"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>