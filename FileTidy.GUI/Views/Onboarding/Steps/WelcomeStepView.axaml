<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="FileTidy.GUI.Views.Onboarding.Steps.WelcomeStepView"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
    <Grid>
        <StackPanel
                    VerticalAlignment="Top"
                    Spacing="24">

            <!-- Subtitle -->
            <TextBlock Text="Let's get your folders clean and organized."
                       FontSize="16"
                       Foreground="Gray"
                       Margin="0,0,0,8" />

            <!-- Checklist Section -->
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="28" Height="28"
                            Background="{DynamicResource SystemAccentBrushDark}"
                            CornerRadius="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock Text="✓"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Sort cluttered files"
                               VerticalAlignment="Center"
                               FontSize="14" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="28" Height="28"
                            Background="{DynamicResource SystemAccentBrushDark}"
                            CornerRadius="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock Text="✓"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Automate your cleanup"
                               VerticalAlignment="Center"
                               FontSize="14" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="28" Height="28"
                            Background="{DynamicResource SystemAccentBrushDark}"
                            CornerRadius="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock Text="✓"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Stay organized"
                               VerticalAlignment="Center"
                               FontSize="14" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>

</UserControl>