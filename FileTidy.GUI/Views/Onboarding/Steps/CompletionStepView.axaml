<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FileTidy.GUI.Views.Onboarding.Steps.CompletionStepView"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="You’re ready" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="You can change folders or preferences anytime in Settings."
                   FontSize="13" Opacity="0.85" HorizontalAlignment="Center"/>
    </StackPanel>

</UserControl>