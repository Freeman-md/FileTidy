<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FileTidy.GUI.Views.Onboarding.Steps.CompletionStepView"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:FileTidy.GUI.ViewModels.Layouts"
             x:DataType="vm:OnboardingWindowViewModel">
    <Grid>
        <StackPanel Spacing="16" HorizontalAlignment="Left">
            <TextBlock Text="All Set!" FontSize="35" FontWeight="SemiBold"/>
            <TextBlock Text="You’re ready to start using FileTidy."
                       FontSize="18"
                       Opacity="0.88"
                       TextWrapping="Wrap"
                       MaxWidth="520"/>
        </StackPanel>
    </Grid>

</UserControl>