<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FileTidy.GUI.ViewModels.Layouts"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FileTidy.GUI.Views.Onboarding.Steps.AccessStepView"
             x:DataType="vm:OnboardingWindowViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto">
        
        <!-- Title -->
        <TextBlock Text="Folder access permissions" FontSize="35" FontWeight="SemiBold"/>

        <!-- Copy + link -->
        <StackPanel Grid.Row="1" Spacing="10" Margin="0,16,0,0">
            <TextBlock Text="FileTidy needs read access to Desktop, Downloads and Documents to work reliably."
                       FontSize="18" Opacity="0.88" TextWrapping="Wrap"/>
            <Button Classes="btn btn-outline btn-sm"
                    Command="{Binding OpenOsSettingsCommand}">
                <Label Classes="btn-text" Content="Open System Settings" />
            </Button>
        </StackPanel>

        <!-- Read-only indicators -->
        <StackPanel Grid.Row="2" Spacing="10" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Label FontFamily="{StaticResource PhosphorFill}"
                       Classes="btn-icon"
                       FontSize="20"
                       Foreground="{StaticResource SuccessColor}"
                       Content="&#xE184;"
                       IsVisible="{Binding DesktopGranted}" />
                
                <Label FontFamily="{StaticResource PhosphorFill}"
                       Classes="btn-icon"
                       FontSize="20"
                       Foreground="{StaticResource ErrorColor}"
                       Content="&#xE4F8;"
                       IsVisible="{Binding DesktopGranted, Converter={StaticResource InverseBoolConverter}}" />

                <TextBlock Text="Desktop" VerticalAlignment="Center"/>
            </StackPanel>


            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Label FontFamily="{StaticResource PhosphorFill}"
                       Classes="btn-icon"
                       FontSize="20"
                       Foreground="{StaticResource SuccessColor}"
                       Content="&#xE184;"
                       IsVisible="{Binding DownloadsGranted}" />

                <Label FontFamily="{StaticResource PhosphorFill}"
                       Classes="btn-icon"
                       FontSize="20"
                       Foreground="{StaticResource ErrorColor}"
                       Content="&#xE4F8;"
                       IsVisible="{Binding DownloadsGranted, Converter={StaticResource InverseBoolConverter}}" />

                <TextBlock Text="Downloads" VerticalAlignment="Center"/>
            </StackPanel>


            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Label FontFamily="{StaticResource PhosphorFill}"
                       Classes="btn-icon"
                       FontSize="20"
                       Foreground="{StaticResource SuccessColor}"
                       Content="&#xE184;"
                       IsVisible="{Binding DocumentsGranted}" />

                <Label FontFamily="{StaticResource PhosphorFill}"
                       Classes="btn-icon"
                       FontSize="20"
                       Foreground="{StaticResource ErrorColor}"
                       Content="&#xE4F8;"
                       IsVisible="{Binding DocumentsGranted, Converter={StaticResource InverseBoolConverter}}" />

                <TextBlock Text="Documents" VerticalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
