<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileTidy.GUI.ViewModels.Layouts"
        xmlns:layouts="clr-namespace:FileTidy.GUI.ViewModels.Layouts"
        x:Class="FileTidy.GUI.Views.Onboarding.OnboardingWindow"
        x:DataType="layouts:OnboardingWindowViewModel"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="48"
        SystemDecorations="Full"
        CanResize="False"
        Background="{StaticResource BackgroundBrush}"
        Title="Welcome to FileTidy">
    



    <Design.DataContext>
        <vm:OnboardingWindowViewModel />
    </Design.DataContext>

    <DockPanel>   

        <!-- 🔷 Custom Title Bar with native macOS buttons support -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                Height="48"
                IsHitTestVisible="True">

            <Grid ColumnDefinitions="48,*,48"
                  VerticalAlignment="Center"
                  Margin="12,0">

                <!-- macOS system buttons will be injected into this space -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8" />

                <!-- Centered logo  -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Image Name="LogoImage"
                           Source="{SvgImage /Assets/Images/logo.svg}"
                           Width="100"
                           Height="100"
                           Cursor="Hand"/>
                </StackPanel>

                <!-- Optional right-side controls -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="8" />
            </Grid>
        </Border>

        <!-- 🔸 Thin Progress Bar -->
        <Border DockPanel.Dock="Top"
                Height="2"
                Background="{StaticResource BorderBrush}">
            <ProgressBar Minimum="0"
                         Maximum="{Binding StepsCountMinusOne}"
                         Value="{Binding CurrentStepIndex}"
                         Background="{x:Null}"
                         Foreground="{StaticResource PrimaryBrush}" />
        </Border>
        
        <Grid>
            <Image Source="/Assets/Images/onboarding/background.png"
                   Stretch="UniformToFill"
                   IsHitTestVisible="False"
                   Opacity="0.15"
                   ZIndex="0"/>
            
            <Border Background="{StaticResource OverlayFaintBrush}"
                    ZIndex="1" 
                    IsHitTestVisible="False"/>
            
            <Grid ZIndex="2" Margin="80 40" ColumnDefinitions="*,*" RowDefinitions="*">
                
                <StackPanel Margin="12 0" Spacing="20" VerticalAlignment="Center">
                    
                    <TransitioningContentControl Grid.Row="0" Content="{Binding CurrentStepView}">
                        <TransitioningContentControl.PageTransition>
                            <CrossFade Duration="0:0:0.15"/>
                        </TransitioningContentControl.PageTransition>
                    </TransitioningContentControl>
                    
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,24,0,0"
                                 Spacing="15"
                                >
                        <Button Classes="btn btn-outline btn-md"
                                Command="{Binding PreviousStepCommand}"
                                IsVisible="{Binding ShowPreviousButton}">
                                <Label Classes="btn-text" Content="Back" />
                        </Button>
                        <Button Classes="btn btn-primary btn-md"
                                Command="{Binding PrimaryActionCommand}"
                                IsEnabled="{Binding CanGoNext}">
                            <Label Classes="btn-text" Content="{Binding PrimaryButtonText}"/>
                        </Button>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="3"
                                Margin="0,24,0,0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                IsVisible="{Binding CanGoNext, Converter={StaticResource InverseBoolConverter}}">
    
                        <!-- Info icon -->
                        <Label FontFamily="{StaticResource PhosphorFill}"
                               FontSize="16"
                               Content="&#xE2CE;" />
    
                        <!-- Tip text -->
                        <TextBlock FontSize="14"
                                   TextWrapping="Wrap"
                                   Text="You can only continue after granting access to at least one folder." />
                    </StackPanel>

                </StackPanel>
                
                <Border Grid.Column="1"
                        Padding="16"
                        ClipToBounds="True"
                        Margin="{Binding PreviewContainerMargin}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                    
                    <Image 
                        Source="{Binding StepPreviewBinding}" 
                        Height="{Binding $parent[Window].Bounds.Height, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.66}"
                    />
                </Border>
            </Grid>
        </Grid>


    </DockPanel>
</Window>
