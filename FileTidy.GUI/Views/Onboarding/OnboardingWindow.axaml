<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onboarding="clr-namespace:FileTidy.GUI.ViewModels.Onboarding"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FileTidy.GUI.Views.Onboarding.OnboardingView"
             x:DataType="onboarding:OnboardingViewModel"
             Background="#f2f2f2">
    
    <Design.DataContext>
        <onboarding:OnboardingViewModel></onboarding:OnboardingViewModel>
    </Design.DataContext>
    
    <Grid
        RowDefinitions="*, Auto, Auto"
        ColumnDefinitions="1*, 2*, 1*"
        VerticalAlignment="Center"
        HorizontalAlignment="Stretch"
        Margin="40">
        <StackPanel
            Grid.Column="1"
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">

            <TextBlock
                Text="{Binding StepTitle}"
                FontSize="28"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0, 0, 0, 6">
            </TextBlock>

            <ContentControl Content="{Binding CurrentStepView}"></ContentControl>
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="20"
            Margin="0, 40, 0, 0">

            <Button
                Classes="btn btn-xl btn-primary"
                Content="Previous"
                Command="{Binding PreviousStepCommand}"
                IsVisible="{Binding ShowPreviousButton}">
            </Button>

            <Button
                Classes="btn btn-xl btn-primary"
                Content="{Binding PrimaryButtonText}"
                Command="{Binding PrimaryActionCommand}"
                IsVisible="{Binding ShowPrimaryButton}">
            </Button>

            <Button
                Classes="btn btn-xl btn-primary"
                Content="Skip"
                Command="{Binding SkipStepCommand}"
                IsVisible="{Binding ShowSkipButton}">

            </Button>

        </StackPanel>
    </Grid>
</UserControl>