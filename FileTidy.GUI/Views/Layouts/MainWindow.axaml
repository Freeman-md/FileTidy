<Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:FileTidy.GUI.Components"
             xmlns:vm="clr-namespace:FileTidy.GUI.ViewModels.Layouts"
             x:DataType="vm:MainWindowViewModel"
             x:Class="FileTidy.GUI.Views.MainWindow"
             Background="#f2f2f2">
    <Grid RowDefinitions="Auto,*,Auto">
        
        <components:Navbar Grid.Row="0" DataContext="{Binding}"/>
        
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
        
        <components:Footer Grid.Row="2"/>
        
    </Grid>
</Window> 