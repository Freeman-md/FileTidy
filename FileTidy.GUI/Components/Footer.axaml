<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FileTidy.GUI.Components.Footer">
    <Border Grid.Row="3" Background="{DynamicResource BackgroundBrush}" HorizontalAlignment="Stretch" Padding="5 7"
            Margin="0 5 0 0">
        <TextBlock TextAlignment="Center" FontSize="10" Foreground="{DynamicResource TextBrush}"
                   Text="FileTidy v1.0.0 | Built by Freemancodz" />
    </Border>
</UserControl>
