<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FileTidy.GUI.ViewModels"
             xmlns:viewModels="clr-namespace:FileTidy.GUI.ViewModels"
             xmlns:components="clr-namespace:FileTidy.GUI.Components"
             xmlns:models="clr-namespace:FileTidy.GUI.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FileTidy.GUI.Components.FolderPanel"
             x:DataType="viewModels:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel></vm:MainViewModel>
    </Design.DataContext>

    <Border Grid.Row="1" Margin="0 5" Padding="10">
        <Grid RowDefinitions="30, *" HorizontalAlignment="Stretch">

            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Spacing="5" Orientation="Horizontal">
                    <ComboBox Width="200" PlaceholderText="Select folder to sort" MaxDropDownHeight="100">
                        <ComboBoxItem Content="Desktop" />
                        <ComboBoxItem Content="Documents" />
                        <ComboBoxItem Content="Downloads" />
                    </ComboBox>
                    <Button Classes="btn btn-primary" Command="{Binding StartTidyingCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Label FontFamily="{StaticResource PhosphorFill}" Content="&#xe6F0;" Classes="btn-icon" />
                            <Label>Start Tidying</Label>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="20" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock VerticalAlignment="Center">
                        <InlineUIContainer>
                            <TextBlock Text="&#xe2c2;" FontFamily="{StaticResource PhosphorFill}" Margin="0 1 0 0" />
                        </InlineUIContainer>
                        <Run Foreground="{DynamicResource TextBrush}" Text="{Binding SelectedFolderPath}" />
                    </TextBlock>

                    <TextBlock VerticalAlignment="Center">
                        <InlineUIContainer>
                            <TextBlock Text="&#xe390;" FontFamily="{StaticResource PhosphorFill}" Margin="0 1 0 0" />
                        </InlineUIContainer>
                        <Run Text="{Binding MockFolderSize}" />
                    </TextBlock>

                </StackPanel>

            </Grid>


            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5"
                    Margin="0 10 0 0">
                <Grid ColumnDefinitions="2*, 1, 5*">

                    <StackPanel Spacing="10">
                        <Border CornerRadius="5 0 0 5" BorderThickness="1" VerticalAlignment="Stretch">

                            <StackPanel VerticalAlignment="Center">
                                <Border BorderThickness="1" Padding="5">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="Folders" VerticalAlignment="Center"></TextBlock>
                                        <Label Grid.Column="1" FontFamily="{StaticResource PhosphorFill}"
                                               Content="&#xe530;" Classes="btn-icon" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TreeView ItemsSource="{Binding FolderTree}"
                                  SelectedItem="{Binding SelectedFolder, Mode=TwoWay}">
                            <TreeView.ItemTemplate> 
                                <TreeDataTemplate DataType="models:FolderItem" ItemsSource="{Binding SubFolders}">
                                    <StackPanel Spacing="5" Orientation="Horizontal">
                                        <Label Content="&#xe25a;" FontFamily="{StaticResource Phosphor}"
                                               FontSize="15" Padding="0">
                                        </Label>
                                        <TextBlock Text="{ Binding Name }"></TextBlock>
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView> 
                    </StackPanel>

                    <Rectangle Grid.Column="1"
                               Width="1"
                               Fill="{DynamicResource BorderBrush}"
                               HorizontalAlignment="Stretch" />

                    <Grid RowDefinitions="Auto, *" Grid.Column="2">
                        <Border CornerRadius="0 5 5 0" BorderThickness="1">
                            <StackPanel>
                                <Border BorderThickness="1" Padding="5">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <CheckBox IsChecked="{Binding IsAllSelected, Mode=TwoWay}" Content="Select All" VerticalAlignment="Center"
                                                  Foreground="{DynamicResource TextBrush}" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                            <Button Classes="btn btn-outline">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <Label FontFamily="{StaticResource PhosphorFill}"
                                                           Content="&#xe038;" Classes="btn-icon" />
                                                    <Label>Revert</Label>
                                                </StackPanel>
                                            </Button>

                                            <Button Classes="btn btn-outline">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <Label FontFamily="{StaticResource Phosphor}"
                                                           Content="&#xe4A6;"
                                                           Classes="btn-icon" />
                                                    <Label>Delete</Label>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding CurrentFiles}" AutoGenerateColumns="False"
                                  GridLinesVisibility="All"
                                  BorderThickness="0" Margin="10 5" CanUserResizeColumns="True"
                                  CanUserSortColumns="False"
                                  RowHeight="35" IsReadOnly="False" FontSize="12" HorizontalScrollBarVisibility="Auto">

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                            
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="150"
                                                    IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Status" Width="120" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <components:StatusBadge Status="{Binding Status}"></components:StatusBadge>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                    </Grid>

                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>