<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FileTidy.GUI.Components.Navbar">
    
    <Border Padding="15 10" Background="{DynamicResource BackgroundBrush}" Margin="0 0 0 5">
        <Grid ColumnDefinitions="Auto, *, Auto">
            <Image Name="LogoImage" Source="{SvgImage /Assets/Images/logo.svg }" Width="100" Cursor="Hand" PointerPressed="LogoImage_PointerPressed" />

            <TextBlock Text="" Grid.Column="1" Margin="2 0" />

            <StackPanel Orientation="Horizontal" Grid.Column="2" Spacing="10">
                <Button Name="SettingsButton" Classes="btn btn-outline" Click="SettingsButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Label FontFamily="{StaticResource PhosphorFill}" Content="&#xe272;" Classes="btn-icon" />
                        <Label>Settings</Label>
                    </StackPanel>
                </Button>
                <Button Name="HelpButton" Classes="btn btn-outline" Click="HelpButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Label FontFamily="{StaticResource PhosphorLight}" Content="&#xe3e8;" Classes="btn-icon" />
                        <Label>Help</Label>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
    
</UserControl>
