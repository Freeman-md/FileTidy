<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.2.7" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.7" />
        <PackageReference Include="Avalonia.Desktop" Version="11.2.7" />
        <PackageReference Include="Avalonia.Svg.Skia" Version="11.2.7.1" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.7" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.7" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics" Version="11.2.7">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.8" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.8" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.8" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.8" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.8" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.8" />
    </ItemGroup>
    

    <ItemGroup>
      <Folder Include="Assets\Images\" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Assets\Images\logo.png" />
      <AvaloniaResource Include="Assets\Images\logo.png" />
      <None Remove="Assets\Images\logo.svg" />
      <AvaloniaResource Include="Assets\Images\logo.svg" />
      <None Remove="Assets\Fonts\Roboto\Black.ttf" />
      <AvaloniaResource Include="Assets\Fonts\Roboto\Black.ttf" />
      <None Remove="Assets\Fonts\Roboto\Bold.ttf" />
      <AvaloniaResource Include="Assets\Fonts\Roboto\Bold.ttf" />
      <None Remove="Assets\Fonts\Roboto\ExtraBold.ttf" />
      <AvaloniaResource Include="Assets\Fonts\Roboto\ExtraBold.ttf" />
      <None Remove="Assets\Fonts\Roboto\ExtraLight.ttf" />
      <AvaloniaResource Include="Assets\Fonts\Roboto\ExtraLight.ttf" />
      <None Remove="Assets\Fonts\Roboto\Light.ttf" />
      <AvaloniaResource Include="Assets\Fonts\Roboto\Light.ttf" />
      <None Remove="Assets\Fonts\Roboto\Medium.ttf" />
      <AvaloniaResource Include="Assets\Fonts\Roboto\Medium.ttf" />
      <None Remove="Assets\Fonts\Roboto\Regular.ttf" />
      <AvaloniaResource Include="Assets\Fonts\Roboto\Regular.ttf" />
      <None Remove="Assets\Fonts\Roboto\SemiBold.ttf" />
      <AvaloniaResource Include="Assets\Fonts\Roboto\SemiBold.ttf" />
      <None Remove="Assets\Fonts\Roboto\Thin.ttf" />
      <AvaloniaResource Include="Assets\Fonts\Roboto\Thin.ttf" />
      <None Remove="Assets\Icons\settings.svg" />
      <AvaloniaResource Include="Assets\Icons\settings.svg" />
      <None Remove="Assets\Fonts\Phosphor\Fill.ttf" />
      <AvaloniaResource Include="Assets\Fonts\Phosphor\Fill.ttf" />
      <None Remove="Assets\Fonts\Phosphor\Light.ttf" />
      <AvaloniaResource Include="Assets\Fonts\Phosphor\Light.ttf" />
      <None Remove="Assets\Fonts\Phosphor\Regular.ttf" />
      <AvaloniaResource Include="Assets\Fonts\Phosphor\Regular.ttf" />
      <None Remove="Assets\Fonts\Phosphor\Thin.ttf" />
      <AvaloniaResource Include="Assets\Fonts\Phosphor\Thin.ttf" />
      <None Remove="Assets\Images\onboarding\background.png" />
      <AvaloniaResource Include="Assets\Images\onboarding\background.png" />
      <None Remove="Assets\Images\onboarding\access-macos.png" />
      <AvaloniaResource Include="Assets\Images\onboarding\access-macos.png" />
      <None Remove="Assets\Images\onboarding\welcome.png" />
      <AvaloniaResource Include="Assets\Images\onboarding\welcome.png" />
      <None Remove="Assets\Images\onboarding\completion.png" />
      <AvaloniaResource Include="Assets\Images\onboarding\completion.png" />
      <None Remove="Assets\Images\help\realtime-folder-size.png" />
      <AvaloniaResource Include="Assets\Images\help\realtime-folder-size.png" />
      <None Remove="Assets\Images\help\getting-started\01.png" />
      <AvaloniaResource Include="Assets\Images\help\getting-started\01.png" />
      <None Remove="Assets\Images\help\getting-started\02.png" />
      <AvaloniaResource Include="Assets\Images\help\getting-started\02.png" />
      <None Remove="Assets\Images\help\revert-last-sort.png" />
      <AvaloniaResource Include="Assets\Images\help\revert-last-sort.png" />
      <Compile Remove="ViewModels\Home\FileListViewModel.cs" />
      <AvaloniaResource Include="ViewModels\Home\FileListViewModel.cs" />
      <None Remove="Assets\Images\help\getting-started\03.png" />
      <AvaloniaResource Include="Assets\Images\help\getting-started\03.png" />
      <None Remove="Assets\Images\help\session-reverted.png" />
      <AvaloniaResource Include="Assets\Images\help\session-reverted.png" />
      <None Remove="Assets\Images\help\sorting-progress-and-notifications.png" />
      <AvaloniaResource Include="Assets\Images\help\sorting-progress-and-notifications.png" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\FileTidy.Core\FileTidy.Core.csproj" />
      <ProjectReference Include="..\FileTidy.Data\FileTidy.Data.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="appsettings.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>


    <ItemGroup>
      <Compile Update="Views\Onboarding\Steps\CompletionStepView.axaml.cs">
        <DependentUpon>CompletionStepView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Onboarding\Steps\WelcomeStepView.axaml.cs">
        <DependentUpon>WelcomeStepView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Pages\HomeView.axaml.cs">
        <DependentUpon>HomeView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Pages\HelpView.axaml.cs">
        <DependentUpon>HelpView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Pages\SettingsView.axaml.cs">
        <DependentUpon>SettingsView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Layouts\MainWindow.axaml.cs">
        <DependentUpon>MainWindow.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>

    <PropertyGroup>
      <RuntimeIdentifiers>osx-x64;osx-arm64;linux-x64;win-x64</RuntimeIdentifiers>
      <UseAppHost>true</UseAppHost>
      <PublishSingleFile>true</PublishSingleFile>
      <SelfContained>true</SelfContained>
    </PropertyGroup>


    <PropertyGroup>
      <CFBundleName>FileTidy</CFBundleName>
      <CFBundleDisplayName>FileTidy</CFBundleDisplayName>
      <CFBundleIdentifier>com.freemancodz.filetidy</CFBundleIdentifier>
      <CFBundleVersion>1.0.0</CFBundleVersion>
      <CFBundleShortVersionString>1.0</CFBundleShortVersionString>
    </PropertyGroup>

    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
      <ApplicationIcon>Assets/Icons/filetidy-icon.ico</ApplicationIcon>
    </PropertyGroup>



</Project>
